# استخدام إصدار نود الحديث والمستقر
FROM node:18-alpine

# تثبيت الأدوات الضرورية لبعض مكتبات بايلز (مثل التعامل مع الصور والشبكات إن لزم)
RUN apk add --no-cache tzdata

# إنشاء مجلد العمل داخل الحاوية
WORKDIR /app

# نسخ ملفات الاعتماديات أولاً لاستغلال التخزين المؤقت (Cache)
COPY package*.json ./

# تثبيت الحزم المطلوبة بدون الحزم التطويرية لتقليل الحجم
RUN npm install --production

# نسخ باقي ملفات المشروع إلى داخل الحاوية
COPY . .

# أمر تشغيل البوت عند بدء الحاوية
CMD ["npm", "start"]
